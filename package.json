    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "ai:server": "node server/index.cjs"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
