{
  "name": "codex-studio-prototype",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
