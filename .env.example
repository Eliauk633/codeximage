# 复制为 .env，仅在服务端填写 Agnes Key；不要提交或分发填写后的文件。
AGNES_API_KEY=

# 生成一次随机访问凭证，替换下面两处相同占位内容；不是 Agnes Key。
# 占位内容不能用于启动，避免误用公开凭证。
STUDIO_GATEWAY_TOKEN=请替换为自己生成的至少32位随机凭证
CODEX_STUDIO_AI_TOKEN=请替换为自己生成的至少32位随机凭证

# 本机运行默认值；远程部署时由 HTTPS 反向代理访问此内部端口。
STUDIO_GATEWAY_HOST=127.0.0.1
STUDIO_GATEWAY_PORT=8787

# 本机客户端默认值；连接远程服务器时改为自己的 HTTPS 网关地址。
CODEX_STUDIO_AI_URL=http://127.0.0.1:8787
